# Install all the Packages needed
library(tidyverse)
library(broom)
library(janitor) # To clean data and turn those to tidy data
library(here) # To navigate through the project oriented workflow (file system)
library(ggridges) # To overlap the created plots
library(viridis) # To generate colored graphs
library(ggthemes) # To get more themes for ggplot
library(ggrepel)   # to repel overlapping text labels
library(patchwork) # To combine two or more plots together
library(ggtext) # To construct a text box
library(umap)
library(factoextra) # Extract and visualize data from multivariate data analyses
library(FactoMineR) # Multivariate Exploratory Data Analysis and Data Mining with R
# Load and prepare data ---------------------------------------------------
# load concentration data with clean names
concentration_data <- clean_names(read.csv(here("data", "concentration_data.csv")))
mean_concentration_data <- clean_names(read.csv(here("data", "mean_concentration_data.csv")))
# load binary data (detect/non-detect)
binary_data <- clean_names(read.csv(here("data","binary_table.csv")))
# Calculation of detection percentage -------------------------------------
binary_data_matrix <- binary_data[,-1]  # Remove sample names column
# Calculate detection percentages
detection_percentages <- colSums(binary_data_matrix) / nrow(binary_data_matrix) * 100
write.csv(detection_percentages, "detection_percentages.csv")
# Select analytes with 75% or higher detection percentage
selected_analytes <- names(detection_percentages[detection_percentages >= 75])
# Filter concentration data to include only selected analytes
filtered_data <- concentration_data %>%
select(all_of(c("sample", "species", "basin", selected_analytes)))
# Apply log10 transformation directly to analyte columns
log_transformed_data <- filtered_data %>%
mutate(across(all_of(selected_analytes), ~ log10(.x + 1))) # Added +1 to handle zeros
# ANOVA Analysis ----------------------------------------------------------
fish_data <- log_transformed_data
# Get analyte columns (all columns except sample, species, basin)
analyte_columns <- colnames(fish_data)[!colnames(fish_data) %in% c("sample", "species", "basin")]
# Function to perform ANOVA for a given basin and analyte
perform_anova <- function(basin_name, analyte) {
# Filter data for the specific basin
basin_data <- fish_data %>% filter(basin == basin_name)
# Perform ANOVA
anova_result <- aov(as.formula(paste(analyte, "~ species")), data = basin_data)
# Extract p-value
p_value <- tidy(anova_result)$p.value[1]
# Return result as a data frame
data.frame(basin = basin_name,
analyte = analyte,
p_value = p_value,
significant = p_value < 0.05)
}
# Create a grid of all combinations of basins and analytes
all_combinations <- expand.grid(
basin = unique(fish_data$basin),
analyte = analyte_columns,
stringsAsFactors = FALSE
)
# Perform ANOVA for all combinations
results <- map2_df(all_combinations$basin, all_combinations$analyte, perform_anova)
# Count number of non-significant basins for each analyte
analyte_consistency <- results %>%
group_by(analyte) %>%
summarize(
num_non_significant = sum(!significant),
num_basins = n(),
proportion_non_sig = num_non_significant / num_basins
) %>%
arrange(desc(num_non_significant))
# View the consistency summary
print("Analyte consistency across basins:")
print(analyte_consistency)
# Select analytes with non-significant results in at least 3 basins
low_var_analytes <- analyte_consistency %>%
filter(num_non_significant >= 3) %>%
pull(analyte)
# Print the selected analytes
print("Analytes with non-significant species differences in ≥3 basins:")
print(low_var_analytes)
# Filter the full results to show only selected analytes
low_var_analytes <- results %>%
filter(analyte %in% low_var_analytes) %>%
arrange(analyte, basin)
# View the detailed results for selected analytes
print("Detailed ANOVA results for selected analytes:")
print(low_var_analytes)
# Save the selected results to CSV
write.csv(low_var_analytes, here("results", "selected_anova_results.csv"), row.names = FALSE)
# Create a visualization of the selected analytes
selected_plot <- ggplot(low_var_analytes, aes(x = analyte, y = -log10(p_value), fill = significant)) +
geom_col(aes(fill = significant), position = "dodge") +
geom_hline(yintercept = -log10(0.05), color = "red", linetype = "dashed") +
facet_wrap(~ basin, nrow = 1) +
scale_fill_manual(values = c("TRUE" = "indianred2", "FALSE" = "steelblue3"),
labels = c("TRUE" = "Significant", "FALSE" = "Non-significant")) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "top") +
labs(title = "Analytes with non-significant species differences in ≥3 basins",
y = "-log10(p-value)",
x = "Analyte",
fill = "Significance")
# Save the plot
ggsave(here("figures", "selected_analytes_plot.png"), selected_plot,
width = 10, height = 6, dpi = 300)
# Step 1: Extract the analytes with low variance (from previous step)
selected_analytes_anova <- low_var_analytes$analyte
selected_analytes_anova
# Step 2: Filter original (non-log) concentration data
# Assume 'concentration_data' is your original data frame (non-log-transformed)
pca_input <- concentration_data %>%
select(sample, species, basin, all_of(selected_analytes_anova))
pca_input
# Assuming 'filtered_data' is a data frame with PAC concentrations from 4th column to the last column
# Calculate the total PAC concentration for each sample using columns 3 to last
concentration_filtered <- pca_input %>%
rowwise() %>% #do the operations raw by raw individually
mutate(Total_PAC = sum(c_across(4:last_col()))) # Take the summary of each raw
concentration_filtered
# Calculate the percent contribution of each analyte (in columns 4 to last) to the total HPAC concentration
percent_normalized_data <- concentration_filtered %>%
mutate(across(4:last_col(), ~ sqrt(. / total))) # ~ introduce the anonymous function to each column and . is representing each sample
