# Save the first plot as a PNG file in the figures folder
ggsave(here("figures", "umap_va1_va2_HPACs.png"), plot = umap_plot_va1_va2, width = 8, height = 6, dpi = 300)
umap_plot_va1_va3 <- ggplot(umap_values, aes(x = Variable1, y = Variable3, color = basin, shape = species)) +
geom_point(size = 3) +
labs(#title = "UMAP of Fish Samples from Lake Erie",
x = "UMAP Variable 1", y = "UMAP Variable 3",
color = "Basin",
shape = "Species") +
theme_minimal(base_size = 12) +
theme(
panel.background = element_rect(fill = "white", color = NA),  # Ensures white background
plot.background = element_rect(fill = "white", color = NA),
axis.title.x = element_text(face = "bold"),# Bold x-axis label
axis.title.y = element_text(face = "bold") )+
scale_color_manual(values = c("Eastern" = "#233d4d",
"East Central" = "#db3a34",
