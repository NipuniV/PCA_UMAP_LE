# Modified biplot function that checks for required columns
create_biplot <- function(pca_data, pca_results, metadata, pc_x = 1, pc_y = 2,
n_loading_labels = 10, point_size = 3,
loading_arrow_color = "red",
loading_label_color = "blue") {
# Extract scores
scores <- as.data.frame(pca_results$ind$coord)
colnames(scores) <- paste0("PC", 1:ncol(scores))
# Combine with metadata
if(!all(c("sample", "species", "basin") %in% colnames(metadata))) {
stop("Metadata must contain 'sample', 'species', and 'basin' columns")
}
scores <- cbind(metadata[, c("sample", "species", "basin")], scores)
# Extract loadings
loadings <- as.data.frame(pca_results$var$coord)
colnames(loadings) <- paste0("PC", 1:ncol(loadings))
# Calculate scaling factor for loadings
scaling_factor <- 0.5 * max(abs(scores[[paste0("PC", pc_x)]])) / max(abs(loadings[[paste0("PC", pc_x)]]))
# Select top loading variables to label
top_loadings <- loadings %>%
mutate(variable = rownames(.),
importance = sqrt(get(paste0("PC", pc_x))^2 + get(paste0("PC", pc_y))^2)) %>%
arrange(desc(importance)) %>%
head(n_loading_labels)
# Create plot
ggplot() +
# Plot samples
geom_point(data = scores,
aes(x = get(paste0("PC", pc_x)),
y = get(paste0("PC", pc_y)),
color = basin,
shape = species),
size = point_size) +
# Plot loading arrows
geom_segment(data = loadings,
aes(x = 0, y = 0,
xend = scaling_factor * get(paste0("PC", pc_x)),
yend = scaling_factor * get(paste0("PC", pc_y))),
arrow = arrow(length = unit(0.2, "cm")),
color = loading_arrow_color,
alpha = 0.7) +
# Label top loadings
geom_text_repel(data = top_loadings,
aes(x = scaling_factor * get(paste0("PC", pc_x)),
y = scaling_factor * get(paste0("PC", pc_y)),
label = variable),
color = loading_label_color,
size = 3,
max.overlaps = Inf) +
# Add aesthetics
labs(#title = paste0("PCA Biplot - PC", pc_x, " vs PC", pc_y),
x = paste0("PC", pc_x, " (", round(pca_results$eig[pc_x, 2], 1), "%)"),
y = paste0("PC", pc_y, " (", round(pca_results$eig[pc_y, 2], 1), "%)"),
color = "Basin",
shape = "Species") +
# Use your existing color and shape schemes
scale_color_manual(values = c("Eastern" = "#233d4d",
"East Central" = "#db3a34",
"West Central" = "#fcca46",
"Western" = "#619b8a")) +
scale_shape_manual(values = c("Yellow Perch" = 8,
"Walleye" = 16,
"Freshwater Drum" = 18,
"Gizzard Shad" = 15)) +
# Add center lines
geom_hline(yintercept = 0, linetype = "dashed", alpha = 0.5) +
geom_vline(xintercept = 0, linetype = "dashed", alpha = 0.5) +
# Theme adjustments
theme_minimal() +
theme(legend.position = "right",
plot.title = element_text(hjust = 0.5),
panel.background = element_rect(fill = "white", color = NA),  # Ensures white background
plot.background = element_rect(fill = "white", color = NA),
axis.title.x = element_text(face = "bold"),# Bold x-axis label
axis.title.y = element_text(face = "bold") )
}
# Assuming you have a metadata data frame with sample information
# If not, create it from your original data:
metadata <- concentration_data[, c("sample", "species", "basin")]
# Now create the biplots
biplot_pc1_pc2 <- create_biplot(percent_normalized_data, pca_results, metadata,
pc_x = 1, pc_y = 2, n_loading_labels = 10)
print(biplot_pc1_pc2)
ggsave(here("figures", "PCA_biplot_PC1_PC2.png"), biplot_pc1_pc2,
width = 10, height = 8, dpi = 300)
biplot_pc1_pc3 <- create_biplot(percent_normalized_data, pca_results, metadata,
pc_x = 1, pc_y = 3, n_loading_labels = 10)
print(biplot_pc1_pc3)
ggsave(here("figures", "PCA_biplot_PC1_PC3.png"), biplot_pc1_pc3,
width = 10, height = 8, dpi = 300)
